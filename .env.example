# Copie para .env e preencha com os dados do seu projeto Firebase.
# Console do Firebase > Configurações do projeto > Seus aplicativos > Configuração do SDK.
# Estes valores não são segredo: o que protege os dados são as regras do Firestore
# (veja firestore.rules) e a lista de membros do espaço de trabalho.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional. Sem ele o Analytics simplesmente não é inicializado.
VITE_FIREBASE_MEASUREMENT_ID=

# Identifica o espaço de trabalho dentro da coleção clm do Firestore.
# Troque para separar ambientes (ex.: producao, homologacao) no mesmo projeto.
VITE_CLM_WORKSPACE=default
