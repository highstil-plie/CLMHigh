rules_version = '2';

// Regras do banco `clm-contratos`, dedicado ao CLM.
//
// Este arquivo governa APENAS esse banco. O `firebase.json` lista só ele, então
// publicar daqui não altera as regras de `(default)`, `central-pj` nem
// `showroom-agenda`, que pertencem a outros sistemas da mesma conta.
//
// Publique com:
//   npm run deploy:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function wsPath(ws) {
      return /databases/$(database)/documents/clm/$(ws);
    }

    function isMember(ws) {
      return request.auth != null
        && exists(wsPath(ws))
        && email() in get(wsPath(ws)).data.members;
    }

    match /clm/{ws} {
      // Qualquer autenticado descobre se o espaço existe; o conteúdo
      // (empresa e lista de membros) só é legível para quem é membro.
      allow get: if request.auth != null && (!exists(wsPath(ws)) || isMember(ws));

      // Primeiro acesso: quem cria o espaço se lista como único membro.
      allow create: if request.auth != null
        && email() != ''
        && request.resource.data.members == [email()];

      // Um membro não pode se excluir da lista nem esvaziá-la.
      allow update: if isMember(ws)
        && request.resource.data.members.size() > 0
        && email() in request.resource.data.members;

      allow delete: if false;

      // Contratos, partes, tarefas, relatórios, modelos, cláusulas e perfis.
      match /{collection}/{docId} {
        allow read, write: if isMember(ws);
      }
    }

    // Nada fora da coleção clm é acessível neste banco.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
